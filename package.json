{
    "name": "web-multimodal-agent-skill",
    "version": "1.0.0",
    "description": "A comprehensive web multimodal agent skill combining VLM (Qwen) + LLM (DeepSeek) + Browser Automation (Playwright) for OpenClaw",
    "main": "dist/index.js",
    "type": "module",
    "bin": {
        "web-multimodal-mcp": "./dist/mcp-server.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "start": "node dist/mcp-server.js",
        "install-browsers": "npx playwright install",
        "test": "npm run build && node test/run-all-tests.js",
        "test:basic": "npm run build && node test/basic-test.js",
        "test:vision": "npm run build && node test/vision-test.js",
        "test:agent": "npm run build && node test/agent-test.js",
        "test:mcp": "npm run build && node test/mcp-server-test.js"
    },
    "keywords": [
        "openclaw",
        "multimodal-agent",
        "vlm",
        "llm",
        "playwright",
        "browser-automation",
        "qwen",
        "deepseek",
        "mcp"
    ],
    "author": "Your Name",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^0.5.0",
        "playwright": "^1.40.0",
        "axios": "^1.6.0",
        "dotenv": "^16.3.1"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.3.0"
    }
}